{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly"
  ],
  "timezone": "UTC",
  "automerge": false,
  "ignoreUnstable": true,
  "packageRules": [
    {
      "matchPackageNames": [
        "kubernetes-sigs/agent-sandbox"
      ],
      "groupName": "agent sandbox version"
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "kuberay-operator"
      ],
      "groupName": "kuberay operator version"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "langfuse/langfuse",
        "langfuse/langfuse-worker"
      ],
      "groupName": "langfuse images"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "rayproject/ray"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^config\\.yaml$/",
        "/^roles/agent_sandbox/defaults/main\\.yaml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)agent_sandbox_version:[ \\t]*[\"']?(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)[\"']?"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "kubernetes-sigs/agent-sandbox",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^config\\.yaml$/",
        "/^roles/kuberay/defaults/main\\.yaml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)kuberay_operator_version:[ \\t]*[\"']?(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)[\"']?"
      ],
      "datasourceTemplate": "helm",
      "packageNameTemplate": "kuberay-operator",
      "registryUrlTemplate": "https://ray-project.github.io/kuberay-helm/",
      "versioningTemplate": "semver"
    }
  ]
}
