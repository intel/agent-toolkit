# SPACE API and data plane on the platform gateway. SPACE authenticates every
# request with its own API key, so the routes add no auth of their own.
{% for r in [
  {'name': 'space-api', 'host': space_api_hostname, 'svc': 'space-api-entry', 'port': 8080, 'timeout': space_api_route_timeout},
  {'name': 'space-data-plane', 'host': space_data_plane_hostname, 'svc': 'space-data-plane-entry', 'port': 8090, 'timeout': space_data_plane_route_timeout},
] %}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ r.name }}
  namespace: {{ space_namespace }}
  labels: {app.kubernetes.io/part-of: space}
spec:
  parentRefs:
    - name: {{ gateway_name | default('eg-gateway') }}
      namespace: {{ gateway_namespace | default('envoy-gateway-system') }}
      sectionName: https
  hostnames: ["{{ r.host }}"]
  rules:
    - timeouts:
        request: {{ r.timeout }}
      backendRefs:
        - name: {{ r.svc }}
          port: {{ r.port }}
{% endfor %}
